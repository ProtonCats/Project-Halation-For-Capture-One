+
+/* the visual of any window, our own or another process's; it never changes for a given X window */
+static BOOL get_window_visual( Window window, XVisualInfo *visual )
+{
+    XVisualInfo *list, wanted = {0};
+    XWindowAttributes attr;
+    BOOL ret = FALSE;
+    int count;
+
+    X11DRV_expect_error( gdi_display, window_visual_error, NULL );
+    ret = XGetWindowAttributes( gdi_display, window, &attr );
+    if (X11DRV_check_error() || !ret) return FALSE;
+
+    wanted.visualid = XVisualIDFromVisual( attr.visual );
+    if (!(list = XGetVisualInfo( gdi_display, VisualIDMask, &wanted, &count ))) return FALSE;
+    if ((ret = count > 0)) *visual = list[0];
+    XFree( list );
+    return ret;
+}
