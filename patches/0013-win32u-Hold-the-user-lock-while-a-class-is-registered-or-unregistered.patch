@@ -621,6 +624,8 @@
 
     /* create the desktop window to trigger builtin class registration */
     get_desktop_window();
+
+    user_lock();
 
     SERVER_START_REQ( destroy_class )
     {
@@ -629,11 +634,14 @@
         if (!wine_server_call_err( req )) class = wine_server_get_ptr( reply->client_ptr );
     }
     SERVER_END_REQ;
-    if (!class) return FALSE;
+    if (!class)
+    {
+        user_unlock();
+        return FALSE;
+    }
 
     TRACE( "%p\n", class );
 
