 /***********************************************************************
+ *              use_constant_alpha
+ *
+ * Constant alpha goes into the surface of a 32-bit window, unless the window's own 3D frames cover that surface.
+ */
+BOOL use_constant_alpha( const struct x11drv_win_data *data, BOOL argb, BYTE alpha, DWORD flags )
+{
+    return argb && !data->embedded && !data->client_window && alpha != 255 &&
+           (flags & (LWA_ALPHA | LWA_COLORKEY)) == LWA_ALPHA;
+}
+
+
+/* the alpha moves between the surface and the opacity hint when the window's own 3D frames come or go */
+static void client_window_changed( struct x11drv_win_data *data )
+{
+    BOOL argb = argb_visual.visualid && xrender_available();
+    DWORD flags;
+    BYTE alpha;
+
+    if (!data->whole_window || layered_overlay_alpha_enabled()) return;
+    if (!NtUserGetLayeredWindowAttributes( data->hwnd, NULL, &alpha, &flags )) return;
+    if (use_constant_alpha( data, argb, alpha, flags ) == !data->use_alpha)
+        NtUserPostMessage( data->hwnd, WM_WINE_UPDATEWINDOWSTATE, 0, 0 );
+}
+
+
