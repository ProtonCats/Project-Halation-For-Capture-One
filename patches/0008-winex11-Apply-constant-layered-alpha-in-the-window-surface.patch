+}
+
+
+/* Only XRender copies between depths, which a 32-bit top-level needs for the frames of its 3D child windows. */
+BOOL xrender_available(void)
+{
+    pthread_once( &init_once, device_init );
+    return xrender_funcs != NULL;
 }
 
 
