winex11.drv: Apply constant layered alpha in the window surface.

Use the ARGB visual for local, non-embedded LWA_ALPHA windows below
full opacity when no colour key is requested. Premultiply a separate
upload image, preserving the GDI backing pixels across repeated flushes.
Reuse win32u's existing alpha_bits and full-surface invalidation when
constant alpha changes. Do not change the driver interface.

Delete _NET_WM_WINDOW_OPACITY on this path, including window recreation,
so compositors honouring the hint do not apply the alpha a second time.
Keep the existing opacity-hint fallback without ARGB or for embedded
and foreign windows. Full opacity, attribute removal and colour-key
requests retain the default-visual path; UpdateLayeredWindow is unchanged.

Applies to: Valve Wine fda79a5 (GE-Proton11-12) after GE's preparation, in order after 0006.
The driver interface version is unchanged (111).

--- a/dlls/winex11.drv/window.c
+++ b/dlls/winex11.drv/window.c
@@ -2951,6 +2951,11 @@
 
     /* set the window opacity */
     if (!NtUserGetLayeredWindowAttributes( data->hwnd, &key, &alpha, &layered_flags )) layered_flags = 0;
+    /* Constant alpha is already in the ARGB surface. Do not multiply it twice. */
+    if (!data->embedded && data->use_alpha && argb_visual.visualid &&
+        data->vis.visualid == argb_visual.visualid &&
+        (layered_flags & (LWA_ALPHA | LWA_COLORKEY)) == LWA_ALPHA && alpha != 255)
+        layered_flags &= ~LWA_ALPHA;
     sync_window_opacity( data->display, data->whole_window, alpha, layered_flags );
     sync_window_input_shape( data );
 
@@ -4032,7 +4037,14 @@
 
     if (data)
     {
-        set_window_visual( data, &default_visual, FALSE );
+        BOOL constant_alpha = !data->embedded && argb_visual.visualid && alpha != 255 &&
+                              (flags & (LWA_ALPHA | LWA_COLORKEY)) == LWA_ALPHA;
+
+        set_window_visual( data, constant_alpha ? &argb_visual : &default_visual, constant_alpha );
+
+        /* The surface carries constant alpha; remove the opacity hint to avoid
+         * applying it again on compositors which support the property. */
+        if (constant_alpha) flags &= ~LWA_ALPHA;
 
         if (data->whole_window)
         {
